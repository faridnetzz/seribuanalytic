# ====================================================================
# SIGAP — Konfigurasi environment
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# ====================================================================

# --- PostgreSQL ---
POSTGRES_USER=sigap
POSTGRES_PASSWORD=sigap_secret
POSTGRES_DB=sigap
POSTGRES_PORT=5432

# --- MQTT (Mosquitto) ---
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- Backend (Node.js API + WebSocket) ---
NODE_ENV=production
BACKEND_PORT=4000

# --- Simulator (event dummy untuk dev) ---
# Jeda antar event dalam milidetik. Kecilkan untuk arus lebih padat.
EVENT_INTERVAL_MS=1500

# --- Engine Python (profil gpu) ---
# Modul yang dijalankan engine buatanmu (sisanya bisa DeepStream murni).
ENGINE_MODULES=pedestrian,waste,water,parking
# Jeda sampling frame untuk modul air/sampah (detik).
FRAME_INTERVAL_S=5

# --- Dashboard (Vue SPA) ---
DASHBOARD_PORT=8080
# URL ini di-bake saat build image dashboard (dibaca browser, bukan container).
VITE_API_BASE=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
